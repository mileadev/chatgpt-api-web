{
  "name": "chatgpt-api-web",
  "version": "2.0.0-perfect",
  "description": "Production-grade Mistral Web Chat API with MCP Server support and automated Chrome/Chromium provisioning",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "start:mistral": "node mistral.js",
    "start:mcp": "node mcp-server-mistral.js",
    "dev": "nodemon index.js",
    "dev:mistral": "nodemon mistral.js",
    "test": "node test.js",
    "test:mistral": "node test.js --mistral",
    "health": "curl http://localhost:3001/health",
    "metrics": "curl http://localhost:3001/metrics"
  },
  "keywords": [
    "chatgpt",
    "mistral",
    "api",
    "web",
    "automation",
    "mcp",
    "model-context-protocol",
    "chrome",
    "chromium",
    "provisioning"
  ],
  "author": "mileadev",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^0.4.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "extract-zip": "^2.0.1",
    "helmet": "^7.1.0",
    "playwright": "^1.44.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mileadev/chatgpt-api-web.git"
  },
  "bugs": {
    "url": "https://github.com/mileadev/chatgpt-api-web/issues"
  },
  "homepage": "https://github.com/mileadev/chatgpt-api-web#readme",
  "config": {
    "security": {
      "rateLimit": {
        "windowMs": 60000,
        "max": 200
      },
      "cors": {
        "origin": ["http://localhost:3000", "https://localhost:3000"],
        "credentials": true
      }
    }
  }
}
