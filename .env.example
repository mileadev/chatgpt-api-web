# Mistral Web Chat API Configuration
# Copy this file to .env and modify as needed

# Server Configuration
PORT=3001
HOST=127.0.0.1

# Chrome DevTools Protocol Configuration
CDP_HOST=127.0.0.1
CDP_PORT=9223

# Mistral Web Chat URL
MISTRAL_URL=https://chat.mistral.ai/

# Chrome/Chromium Configuration
# Set CHROME_PATH to manually specify Chrome executable location
# If not set, the service will auto-detect from common paths
CHROME_PATH=

# Run Chrome in headless mode (recommended for servers)
CHROME_HEADLESS=true

# Authentication
# Set API_KEY to enable API key authentication
API_KEY=

# Require API key for all requests
REQUIRE_API_KEY=false

# Logging Configuration
# LOG_LEVEL can be: error, warn, info, debug, trace
LOG_LEVEL=info

# Resource Limits
MAX_CONVERSATIONS=200
MAX_CONCURRENT_REQUESTS=50

# Timeout Configuration (milliseconds)
RESPONSE_TIMEOUT=120000
STREAM_POLL_MS=50
STABLE_MS=1500
CHROME_START_TIMEOUT=30000
PAGE_LOAD_TIMEOUT=45000

# Cleanup Configuration
CLEANUP_INTERVAL=300000
SESSION_TIMEOUT=3600000

# Data Directory
# Default: ./data-mistral
DATA_DIR=./data-mistral

# Request Size Limits
REQUEST_LIMIT=4mb
JSON_LIMIT=2mb

# Rate Limiting
API_RATE_LIMIT=200
CHAT_RATE_LIMIT=100

# CORS Configuration
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://localhost:3000,https://127.0.0.1:3000

# Trust Proxy
# Set to true if running behind a reverse proxy
TRUST_PROXY=false