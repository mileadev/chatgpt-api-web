# ChatGPT provider (default entrypoint: npm start)
HOST=127.0.0.1
PORT=3000

# Required (>=32 chars) whenever HOST is non-loopback. Recommended everywhere.
# Generate with: openssl rand -hex 32
API_KEY=

# Chrome DevTools Protocol is intentionally restricted to loopback.
CDP_HOST=127.0.0.1
CDP_PORT=9222

# Override only when Chrome is installed elsewhere.
# CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome

# ChatGPT runtime storage. PROFILE_DIR is relative to DATA_DIR unless absolute.
DATA_DIR=data
PROFILE_DIR=chrome-profile

# Mistral provider (entrypoint: npm run start:mistral)
# Provider-prefixed values take precedence over generic HOST/API_KEY/ALLOWED_* values.
MISTRAL_HOST=127.0.0.1
MISTRAL_PORT=3001
MISTRAL_CDP_HOST=127.0.0.1
MISTRAL_CDP_PORT=9223
MISTRAL_DATA_DIR=data-mistral
MISTRAL_PROFILE_DIR=chrome-profile
MISTRAL_API_KEY=
MISTRAL_ALLOWED_ORIGINS=
MISTRAL_ALLOWED_HOSTS=

# Browser/runtime tuning shared by providers unless a provider-specific value exists.
CHROME_HEADLESS=false
LOCALE=en-US
RESPONSE_TIMEOUT=60000
STREAM_POLL_MS=100
STABLE_MS=1200

# Request/queue controls.
REQUEST_BODY_LIMIT=1mb
MAX_MESSAGE_CHARS=100000
MAX_CONVERSATIONS=250
MAX_QUEUE_DEPTH=20
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60

# Browser clients must use exact configured origins. Native clients send no Origin.
# ALLOWED_ORIGINS=https://local-ui.example,http://127.0.0.1:8080
ALLOWED_ORIGINS=
ALLOWED_HOSTS=
TRUST_PROXY=false

# Privacy/logging. Prompt bodies and last responses are not persisted by default.
LOG_LEVEL=info
LOG_TO_FILE=false
LOG_PROMPT_CONTENT=false
STORE_LAST_RESPONSE=false

# HTTP server timeouts.
SERVER_REQUEST_TIMEOUT_MS=120000
SERVER_HEADERS_TIMEOUT_MS=15000
SERVER_KEEPALIVE_TIMEOUT_MS=5000
SHUTDOWN_TIMEOUT_MS=10000
